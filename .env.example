# Frontend (Vite): se lee durante npm run build
VITE_API_URL=http://localhost:8000

# Backend: CORS, separa múltiples orígenes con coma
FRONTEND_ORIGINS=http://localhost:5173

# Backend: JWT; en producción usa un secreto largo y aleatorio
JWT_SECRET_KEY=change-me-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Backend: PostgreSQL. Si no se configura, el backend usa SQLite local.
# DATABASE_URL=postgresql://worksheet:worksheet@localhost:5432/worksheet_builder

# Demo seed: por defecto se activa en SQLite y se desactiva en PostgreSQL.
# En producción déjalo en false.
SEED_DEMO_USERS=false
# DEMO_ADMIN_PASSWORD=admin123
# DEMO_TEACHER_PASSWORD=profesor123
# DEMO_STUDENT_PASSWORD=estudiante123

# ── Acceso con Google (Google Identity Services) ─────────────────────────────
# El mismo Client ID va en las dos: el frontend lo usa para pintar el botón y el
# backend para comprobar que el ID token es de esta aplicación (claim "aud").
# Se saca de Google Cloud Console → Credenciales → ID de cliente de OAuth (Web).
# En "Orígenes autorizados de JavaScript" hay que añadir la URL del frontend
# (http://localhost:5173 en local y la de producción).
# El client_secret NO se usa: se valida el ID token, no el flujo de código.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# ── Subida de imágenes (Cloudinary) ──────────────────────────────────────────
# Se sacan del Dashboard de cloudinary.com (plan gratuito). Sin ellas el botón
# "Subir imagen" de la Biblioteca responde 503; las URLs de Unsplash siguen igual.
# El API_SECRET solo firma en el backend: no se envía nunca al navegador.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Voces (ElevenLabs) ───────────────────────────────────────────────────────
# elevenlabs.io → Developers → API Keys. Con la clave, el audio de las hojas lo sintetiza
# ElevenLabs y se guarda en la tabla tts_cache (cada mp3 se paga una vez). Sin ella, o si
# ElevenLabs falla (cuota agotada), el backend sigue usando edge-tts. El plan gratuito
# (10 000 créditos/mes) es solo para uso no comercial y exige atribuir a ElevenLabs.
# La clave necesita permisos de Text to Speech y de Voices (Read). Es la que empieza por sk_ y
# se muestra UNA vez al crearla, no el ID de la clave que aparece en la lista.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2   # eleven_flash_v2_5 gasta la mitad de créditos
# Voz de la cuenta que sustituye a cada nombre de edge-tts (opcional; si no, por etiquetas):
# ELEVENLABS_VOICES=en-US-AndrewNeural=Chris,en-US-AriaNeural=Bella,en-US-RogerNeural=Will
